# Where the tests point and who they log in as.
# Any value here can be overridden on the command line:
#     mvn test -DbaseUrl=http://localhost:3000
# For the local Docker backend, copy this file to config.local.properties,
# fill in local values and run with -DconfigFile=config.local.properties.

# testnearz.co.in is PRODUCTION: the live app and the B2B website use it.
# The suite refuses to write there unless -DallowProductionWrites=true.
baseUrl = https://www.testnearz.co.in

# Salon 4536 - a real salon on production, with real data. Journeys only READ here.
ownerSalonId = 4536
ownerToken   = PASTE_4536_TOKEN

# Salon 4550 - empty. Every journey that WRITES writes here.
journeySalonId = 4550
journeyToken   = PASTE_4550_TOKEN

# Salon 1725 - the second tenant, for isolation checks.
# It must keep its seeded data, or the tenant-leak test has nothing to detect.
otherSalonId = 1725
otherToken   = PASTE_1725_TOKEN

# Optional. Leading digits of every phone the suite creates, so test users can
# be found with mobile LIKE '600%'. 3-4 digits, starting 6-9, not 91. Agree
# the block with the backend team first. Default: 600
# testPhonePrefix = 600
