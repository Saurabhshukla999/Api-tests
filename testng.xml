<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- One thread, on purpose. Every journey asserts an exact report delta;
     two running at once against the same salon would each see the other's
     money and every delta would be wrong. Measured: 18 tests failed under
     8 threads and all of them passed serially. -->
<suite name="Nearz API tests" parallel="none" thread-count="1">

  <!-- Tests that reproduce a known open defect. They SHOULD fail, so they are
       excluded from the normal run and kept visible on demand:
           mvn test -Dgroups=known-defect                                  -->
  <groups>
    <run><exclude name="known-defect"/></run>
  </groups>

  <test name="CRUD - products (the plain shape)">
    <classes><class name="com.nearz.api.ProductCrudTest"/></classes>
  </test>

  <test name="Block 1 - enquiry to settled bill (API-E2E-001..025)">
    <classes><class name="com.nearz.api.Block1EnquiryTest"/></classes>
  </test>

  <test name="Block 4 - appointment lifecycle (API-E2E-026..050)">
    <classes><class name="com.nearz.api.Block4AppointmentTest"/></classes>
  </test>

  <test name="Block 2 - payments and settlement (API-E2E-076..100)">
    <classes><class name="com.nearz.api.Block2PaymentTest"/></classes>
  </test>

  <test name="Block 3 - refunds and reversal (API-E2E-101..125)">
    <classes><class name="com.nearz.api.Block3RefundTest"/></classes>
  </test>

</suite>
